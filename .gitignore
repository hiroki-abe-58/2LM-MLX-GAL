__pycache__/
*.pyc
.DS_Store
.venv/

# 生成物（学習で再現できるものはコミットしない）
data/corpus*.txt
data/corpus*.meta.json
data/cache*/
data/exp/
data/raw/*
!data/raw/.gitkeep
# 検査を通したギャルコーパスは成果物なので配布する（約400KB）
!data/raw/gal_chat.jsonl

# 検査前の生成物は追跡しない。generate.py で作り直せる
data/gal/raw.jsonl
data/gal/topics.txt

# 学習済みモデルは配布したいので final と gal だけ追跡する（各約53MB）
checkpoints/*
!checkpoints/final
!checkpoints/gal

# 学習ログは絶対パスを含むので loss.csv と評価結果だけ残す
runs/*
!runs/loss.csv
!runs/loss_gal.csv
!runs/eval_*.json
# 対照実験の損失曲線は記事の根拠なので残す
!runs/exp/
runs/exp/*
!runs/exp/*.csv

# 記事の原稿はローカル管理（docs/images だけ公開する）
docs/*.md
tools/to_note.py

# windowsに渡す用
win/*
